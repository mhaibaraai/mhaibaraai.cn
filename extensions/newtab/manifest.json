{
  "manifest_version": 3,
  "name": "YiXuan Start",
  "description": "用 mhaibaraai.cn/start 替换 Chrome 新标签页，离线时显示缓存的书签。",
  "version": "1.0.0",
  "icons": { "128": "icon.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage"],
  "host_permissions": ["https://mhaibaraai.cn/*"]
}
